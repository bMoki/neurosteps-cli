# NeuroSteps Workspace CLI — Required Environment Variables
# Copy this file to .env and fill in your values

# ─── Product Identity (Required) ───
NS_PRODUCT_NAME=neurosteps
NS_BACKEND_MODULE=scalemed
NS_BACKEND_REPO_NAME=scalemed-backend
NS_MANAGER_REPO_NAME=neurosteps-manager

# ─── Docker Seed Volume (Required) ───
# Full name of the Docker volume used for DB seeding
NS_SEED_VOLUME=scalemed-backend_neurosteps_bd_volume

# ─── Paths (Optional — defaults shown) ───
# NS_BASE_DIR=/Users/YOUR_USERNAME/Developer
# NS_BACKEND_REPO=/Users/YOUR_USERNAME/Developer/scalemed-backend
# NS_FRONTEND_REPO=/Users/YOUR_USERNAME/Developer/frontend
# NS_MANAGER_REPO=/Users/YOUR_USERNAME/Developer/neurosteps-manager

# ─── PostgreSQL Credentials (Optional — defaults shown) ───
# NS_DB_USER=postgres
# NS_DB_PASSWORD=docker
# NS_DB_NAME=app_database

# ─── Ports (Optional — defaults shown) ───
# NS_MASTER_* are baseline ports used when allocating new branch workspaces.
# ns init does not create a master workspace.
# NS_MASTER_DB_PORT=5434
# NS_MASTER_BACKEND_PORT=8080
# NS_MASTER_FRONTEND_PORT=3011
# NS_MASTER_MANAGER_PORT=3020
# NS_PORTLESS_PROXY_PORT=1355
